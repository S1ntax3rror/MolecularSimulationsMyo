* GENERATED BY CHARMM-GUI (http://www.charmm-gui.org) v1.8 on Feb, 06. 2017. JOBID=1486388593
* INPUT FILE FOR NVT DYNAMICS OF SOLVATED GLOBULAR PROTEIN
*

DIMENS CHSIZE 3000000 MAXRES 3000000

! CO bound setup (0: bound, 1: unbound
set co1 1
set co2 1
set co3 1
set co4 0

! Change HEME to HEM5 when CO not bound and count
if co1 .gt. 0 then
  system "python3 manipulate.py heme HETA HEM5"
!else
!  system "python3 manipulate.py heme HETA HEME"
endif
if co2 .gt. 0 then
  system "python3 manipulate.py heme HETB HEM5"
!else
!  system "python3 manipulate.py heme HETB HEME"
endif
if co3 .gt. 0 then
  system "python3 manipulate.py heme HETC HEM5"
!else
!  system "python3 manipulate.py heme HETC HEME"
endif
if co4 .gt. 0 then
  system "python3 manipulate.py heme HETD HEM5"
!else
!  system "python3 manipulate.py heme HETD HEME"
endif

! OpenMM setup
if @?var ne 0 then
  set var = variable vtol @var
else
  set var =
endif
!set do_omm = omm @var
set cnsT = omm langevin gamma 5 @var
set do_omm = @cnsT

! ??????
set nsteps 100000
set temp 303.15
set nbond = inbfrq @nsteps imgfrq @nsteps ! Check effect if even
set grape = grape 11 ! Fastest gpu but only NVT/NVE

envi VG_LDIMX 7
envi VG_LDIMY 7
envi VG_LDIMZ 7

! Read topology and parameter files
stream toppar.str

! Read PSF
open read unit 10 card name init_setup.psf
read psf  unit 10 card xplor

! Read Coordinate from
set scnt 10
open read unit 10 card name init_setup.crd
read coor unit 10 card


scalar charge stat
set chrg ?CGTOT


!TODO break if charge is not approximately 0
!if (    @chrg .le. -0.1   ) .or. (   @chrg .ge. 0.1    ) then
!  stop
!else
!  set charge 0
!endif
!
! Change Heme coordination
!
! Link HEME to Protein
!patch PHEM PROA 87 HETA 142 noangle nodihedral
!patch PHEM PROB 92 HETB 147 noangle nodihedral
!patch PHEM PROC 87 HETC 142 noangle nodihedral
!patch PHEM PROD 92 HETD 147 noangle nodihedral

! Link or unlink CO to HEME
if co1 .gt. 0 then
  patch ULIG COA    1 HETA 142 PROA 87 noangle nodihedral
!else
!  patch PLIG COA    1 HETA 142 PROA 87 noangle nodihedral
endif
if co2 .gt. 0 then
  patch ULIG COB    1 HETB 147 PROB 92 noangle nodihedral
!else
!  patch PLIG COB    1 HETB 147 PROB 92 noangle nodihedral
endif
if co3 .gt. 0 then
  patch ULIG COC    1 HETC 142 PROC 87 noangle nodihedral
!else
!  patch PLIG COC    1 HETC 142 PROC 87 noangle nodihedral
endif
if co4 .gt. 0 then
  patch ULIG COD    1 HETD 147 PROD 92 noangle nodihedral
!else
!  patch PLIG COD    1 HETD 147 PROD 92 noangle nodihedral
endif

open write unit 10 card name run_setup.psf
write  psf unit 10 card
close unit 10

open write unit 10 card name run_setup.crd
write  coor unit 10 card
close unit 10

stop
