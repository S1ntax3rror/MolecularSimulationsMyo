* INPUT FILE FOR NVT DYNAMICS OF SOLVATED GLOBULAR PROTEIN
*

DIMENS CHSIZE 3000000 MAXRES 3000000

! OpenMM setup
if @?var ne 0 then
  set var = variable vtol @var
else
  set var =
endif

! ??????
set nsteps 100000
set temp 303.15
set nbond = inbfrq @nsteps imgfrq @nsteps ! Check effect if even
set grape = grape 10 ! Fastest gpu but only NVT/NVE

envi VG_LDIMX 7
envi VG_LDIMY 7
envi VG_LDIMZ 7

! Read topology and parameter files
stream toppar.str

! Read PSF
open read unit 10 card name step3_pbcsetup.psf
read psf  unit 10 card xplor

! Read Coordinate from
set scnt 10

open read unit 10 card name step5_@scnt.crd
read coor unit 10 card



!
! Change Heme coordination
!

! Link HEME to Protein
!patch PHEM PROA 87 HETA 142 noangle nodihedral
!patch PHEM PROB 92 HETB 147 noangle nodihedral
!patch PHEM PROC 87 HETC 142 noangle nodihedral
!patch PHEM PROD 92 HETD 147 noangle nodihedral

! Link CO to HEME (+ HEME to His)
!patch PLIG COA    1 HETA 142 PROA 87 noangle nodihedral
!patch PLIG COB    1 HETB 147 PROB 92 noangle nodihedral
!patch PLIG COC    1 HETC 142 PROC 87 noangle nodihedral
!patch PLIG COD    1 HETD 147 PROD 92 noangle nodihedral

! Unlink CO from HEME
patch ULIG COA    1 HETA 142 PROA 87 noangle nodihedral
patch ULIG COB    1 HETB 147 PROB 92 noangle nodihedral
patch ULIG COC    1 HETC 142 PROC 87 noangle nodihedral
!patch ULIG COD    1 HETD 147 PROD 92 noangle nodihedral


open write unit 10 card name step6_manipulation.psf
write  psf unit 10 card
close unit 10

!
! Setup PBC (Periodic Boundary Condition)
!

stream step3_pbcsetup.str

!
! Image Setup
!

open read unit 10 card name crystal_image.str
CRYSTAL DEFINE @XTLtype @A @B @C @alpha @beta @gamma
CRYSTAL READ UNIT 10 CARD


!
! Set Langevin friction coefficient fbeta
!
scalar fbeta set 0.1 sele all end ! Langevin


!
! Test energy run
!

energy @nbond -
     eps 1.0 cutnb 16.0 cutim 16.0 ctofnb 12.0 ctonnb 10.0 vswi -
     Ewald kappa 0.320 pmEwald order 4 fftx 64 ffty 64 fftz 64 - !PME
     omm langevin gamma 10 variable vtol 3e-3 - ! turn on openmm, set-up variabl
     -                                          ! timestep Langevin dynamics
     prmc pref 1 iprsfrq 25                     ! set-up MC barostat at 1 atm, move attempt / 25 steps


!
! Unlinked CO position optimization
!
cons fix sele .not. (resname CO .or. type FE) end
mini sd nstep 100
cons fix sele none end

open write unit 10 card name step6_mini.pdb
write coor unit 10 pdb
close unit 10

open write unit 10 card name step6_mini.crd
write coor unit 10 card
close unit 10

!
! Set constraints
!

faster on
shake bonh param fast tol 1.0e-6


!
! Read velocities from restart file
!

open read unit 11 card name step5_@scnt.res
read coor dynr vel unit 11 COMP
close unit 11

!
! Start simulation with old velocities but CO position optimized
!

set cnt 0
label loopd

  if @cnt .eq. 0 then

    open write unit 12 card name step6_0.res
    open write unit 13 file name step6_0.dcd
    DYNA leap start time 0.001 nstep @nsteps -
         nprint 100 iprfrq 100 ntrfrq 500 -
         iunread -1 iunwri 12 iuncrd 13 iunvel -1 kunit -1 -
         iasors 1 iasvel 0 -
         nsavc 1000 nsavv 0 -
         tbath @temp ihtfrq 0 - ! Only Langevin thermostate, no other 'ihtfrq 0'
         @grape -       
         @nbond echeck -1 -
         eps 1.0 cutnb 16.0 cutim 16.0 ctofnb 12.0 ctonnb 10.0 vswi -
         Ewald kappa 0.320 pmEwald order 4 fftx @fftx ffty @ffty fftz @fftz - !PME
         omm langevin gamma 10 variable vtol 3e-3 - ! turn on openmm, set-up variabl
         -                                          ! timestep Langevin dynamics
         prmc pref 1 iprsfrq 25

    open write unit 10 card name step6_0.pdb
    write coor unit 10 pdb
    close unit 10

    open write unit 10 card name step6_0.crd
    write coor unit 10 card
    close unit 10

  else

    calc pcnt = @cnt - 1
    open read  unit 11 card name step6_@pcnt.res
    open write unit 12 card name step6_@cnt.res
    open write unit 13 file name step6_@cnt.dcd

    DYNA leap restart time 0.001 nstep @nsteps -
         nprint 100 iprfrq 100 ntrfrq 500 -
         iunread 11 iunwri 12 iuncrd 13 iunvel -1 kunit -1 -
         nsavc 1000 nsavv 0 -
         tbath @temp ihtfrq 0 - ! Only Langevin thermostate, no other 'ihtfrq 0'
         @grape -
         @nbond echeck -1 -
         eps 1.0 cutnb 16.0 cutim 16.0 ctofnb 12.0 ctonnb 10.0 vswi -
         Ewald kappa 0.320 pmEwald order 4 fftx @fftx ffty @ffty fftz @fftz - !PME
         omm langevin gamma 10 variable vtol 3e-3 - ! turn on openmm, set-up variabl
         prmc pref 1 iprsfrq 25


    open write unit 10 card name step6_@cnt.pdb
    write coor unit 10 pdb
    close unit 10

    open write unit 10 card name step6_@cnt.crd
    write coor unit 10 card
    close unit 10

  endif

  incr cnt by 1

if cnt .le. 11   goto loopd

stop
