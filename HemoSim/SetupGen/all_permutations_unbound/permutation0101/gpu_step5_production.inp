DIMENS CHSIZE 3000000 MAXRES 3000000

! OpenMM setup
if @?var ne 0 then
  set var = variable vtol @var
else
  set var =
endif
!set do_omm = omm @var
set cnsT = omm langevin gamma 5 @var
set do_omm = @cnsT

! ??????
set nsteps 100000
set temp 303.15
set nbond = inbfrq @nsteps imgfrq @nsteps ! Check effect if even
set grape = grape 11 ! Fastest gpu but only NVT/NVE

envi VG_LDIMX 7
envi VG_LDIMY 7
envi VG_LDIMZ 7

! Read topology and parameter files
stream toppar.str

! Read PSF
open read unit 10 card name step3_pbcsetup.psf
read psf  unit 10 card xplor

! Read Coordinate
open read unit 10 card name step4_equilibration.crd
read coor unit 10 card


!
! Setup PBC (Periodic Boundary Condition)
!

stream step3_pbcsetup.str

!
! Image Setup
!

open read unit 10 card name crystal_image.str
CRYSTAL DEFINE @XTLtype @A @B @C @alpha @beta @gamma
CRYSTAL READ UNIT 10 CARD

! Image centering by residue
IMAGE BYRESID XCEN @xcen YCEN @ycen ZCEN @zcen sele resname TIP3 end
IMAGE BYRESID XCEN @xcen YCEN @ycen ZCEN @zcen sele ( segid @posid .or. segid @negid ) end

!
!use a restraint to place center of mass of the molecules near the origin
!

!MMFP
!GEO rcm sphere -
!    Xref @xcen Yref @ycen Zref @zcen XDIR 1.0 YDIR 1.0 ZDIR 1.0 -
!    harmonic FORCE 1.0 select .not. ( hydrogen .or. resname TIP3 .or. segid @posid .or. segid @negid ) end
!END

!cons fix sele type FE end

!
! Set Langevin friction coefficient fbeta
!
scalar fbeta set 0.1 sele all end ! Langevin

!
! Set constraints
!
faster on
shake bonh param fast

!
! Move cell to avoid unwrapping on GPU
!
COORdinates TRANslate XDIR 45. YDIR 45. ZDIR 45.

!
! Test energy run
!
energy @nbond -
     eps 1.0 cutnb 16.0 cutim 16.0 ctofnb 12.0 ctonnb 10.0 vswi -
     Ewald kappa 0.320 pmEwald order 4 fftx 64 ffty 64 fftz 64 - !PME
     @{do_omm}




! Equi

set equi 1
if @equi .eq. 1 then

open write unit 12 card name step5_0.res
open write unit 13 file name step5_0.dcd
DYNA leap start time 0.001 nstep @nsteps -
     firstt @temp finalt @temp tbath @temp -
     twindl -5.0 twindh 5.0 teminc 30.0 -
     nprint 100 iprfrq 100 ntrfrq 500 -
     iunread -1 iunwri 12 iuncrd 13 iunvel -1 kunit -1 -
     nsavc 1000 nsavv 0 -
     @nbond echeck -1 -
     @grape -
     eps 1.0 cutnb 16.0 cutim 16.0 ctofnb 12.0 ctonnb 10.0 vswi -
     Ewald kappa 0.320 pmEwald order 4 fftx 64 ffty 64 fftz 64 - !PME
     @{do_omm} ! Here should be langevin gamma 5

open write unit 10 card name step5_0.pdb
write coor unit 10 pdb
close unit 10

open write unit 10 card name step5_0.crd
write coor unit 10 card
close unit 10

endif

! Prod

set cnt 1
label loopd

calc pcnt = @cnt - 1
open read  unit 11 card name step5_@pcnt.res
open write unit 12 card name step5_@cnt.res
open write unit 13 file name step5_@cnt.dcd

DYNA leap restart time 0.001 nstep @nsteps -
     nprint 100 iprfrq 100 ntrfrq 500 -
     iunread 11 iunwri 12 iuncrd 13 iunvel -1 kunit -1 -
     nsavc 1000 nsavv 0 -
     tbath @temp ihtfrq 0 - ! Only Langevin thermostate, no other 'ihtfrq 0'
     @grape -
     @nbond echeck -1 -
     eps 1.0 cutnb 16.0 cutim 16.0 ctofnb 12.0 ctonnb 10.0 vswi -
     Ewald kappa 0.320 pmEwald order 4 fftx 64 ffty 64 fftz 64 - !PME
     @{do_omm} ! Here should be langevin gamma 5

open write unit 10 card name step5_@cnt.pdb
write coor unit 10 pdb
close unit 10

open write unit 10 card name step5_@cnt.crd
write coor unit 10 card
close unit 10

incr cnt by 1
if cnt .le. 10   goto loopd

stop
